{
  "name": "kalliopeserver",
  "version": "2.5.0",
  "main": "./server/main.js",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "private": true,
  "scripts": {
    "dev": "npm run build:backend && concurrently --restart-tries -1 --restart-after 5000 -n \"vite,node,tsc\" -c \"bgYellow.bold,bgGreen.bold,bgBlue.bold\" \"vite\" \"node --watch . development\" \"tsc -p tsconfig.backend.json --watch --preserveWatchOutput\"",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "vite build",
    "start": "node .",
    "lint": "eslint .",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "preview-release": "npm run release -- --dry-run"
  },
  "dependencies": {
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@icons-pack/react-simple-icons": "^11.2.0",
    "@phosphor-icons/react": "^2.1.7",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "discord-api-types": "^0.38.55",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "imagescript": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^7.18.4",
    "react-swipeable": "^7.0.2",
    "react-toastify": "^11.0.3",
    "vanilla-tilt": "^1.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@commitlint/types": "^19.5.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "commit-and-tag-version": "^13.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "sass": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
